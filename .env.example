# ============================================================
# 艾哥SaaS工作台 · 环境变量模板
# 使用方式：复制本文件为 .env，再按实际环境填写
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
# ============================================================

# ---------------- 服务端口 ----------------
# REST API 端口（宝塔 Nginx 反向代理指向它）
PORT=3000
# MCP Server 端口（AI 工具如 Trae 通过 SSE 连接）
MCP_PORT=3001

# ---------------- 安全密钥（务必修改！） ----------------
# JWT 登录令牌签名密钥，建议：openssl rand -hex 32
JWT_SECRET=please_change_me_to_a_random_hex_string
# JWT 有效期
JWT_EXPIRES_IN=7d
# 敏感配置加密密钥（宝塔API密钥 / Cloudflare Token 用它做 AES-256-GCM 加密）
# 至少 32 位随机字符串，建议：openssl rand -hex 32
ENCRYPTION_KEY=please_change_me_to_32_chars_random_secret
# MCP Server 连接令牌（AI 工具连接 /sse 时必须携带，建议：openssl rand -hex 16）
MCP_AUTH_TOKEN=please_change_me_mcp_token

# ---------------- 默认管理员（仅首次启动自动创建） ----------------
# 登录后请立刻在「系统设置 → 管理员账号」里改掉
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin888

# ---------------- 宝塔面板（可留空，登录后在「系统设置」里填） ----------------
# ⚠️ 这里填「API 根地址」：协议 + IP + 端口即可。
#    浏览器里复制的完整地址带安全入口路径（形如 https://IP:11927/c6b348fb），
#    那个路径是登录页入口，宝塔 API 不认，带上会直接返回 404。
BT_PANEL_URL=https://127.0.0.1:11927
# 宝塔面板 → 设置 → API 接口 → 密钥
BT_API_KEY=
# 面板用 IP + 自签证书提供 HTTPS 时置 true，否则 Node 会因证书不可信直接拒连
# （只影响这一条通道，不会削弱 Cloudflare 等公网接口的证书校验）
BT_ALLOW_INSECURE_TLS=true

# ---------------- Cloudflare（可留空，登录后在「系统设置」里填） ----------------
# 使用 API Token（不是 Global API Key），权限建议：Zone:DNS:Edit + Zone:Zone:Read
CF_API_TOKEN=
# 账号邮箱（仅用于展示与核对，API 调用用 Token 认证）
CF_ACCOUNT_EMAIL=

# ---------------- Docker 连接 ----------------
# 本机 socket（推荐，docker-compose 已挂载 /var/run/docker.sock）
DOCKER_HOST=unix:///var/run/docker.sock
# 远程 Docker 可改为：tcp://1.2.3.4:2375
# 若 Docker 守护进程启用了 TLS，可在此填入证书目录（留空表示不启用）
DOCKER_TLS_CERT_PATH=

# ---------------- 应用部署相关 ----------------
# 部署的应用容器统一使用的外部网络（不存在会自动创建）
DEPLOY_NETWORK=aige-apps
# 应用数据在「工作台容器内」的根目录（一般不用改）
DEPLOY_DATA_DIR=/app/data/apps
# 【关键】宿主机上与本项目 ./data 对应的绝对路径。
# 后端跑在容器里，但交给 Docker 守护进程的挂载路径必须是宿主机路径，二者不同。
# 例：项目 clone 在 /root/aige-saas-workbench，则这里填 /root/aige-saas-workbench/data/apps
# 留空 = 不使用目录挂载，改用 Docker 命名卷持久化（更省事，但看/备份数据要用 docker volume 命令）
HOST_DATA_DIR=
# 服务器公网 IP（部署应用时用于生成 DNS A 记录指向；留空则部署时自动探测）
SERVER_PUBLIC_IP=
# 新应用默认使用的 Docker 镜像加速（国内服务器建议保留，留空则用镜像自带默认源）
DOCKER_REGISTRY_MIRROR=

# ---------------- 代码仓库（GitHub，可留空，登录后在「系统设置」里填） ----------------
# 只读用途的令牌。留空 = 匿名访问：公开仓库也能读，但配额只有 60 次/小时
# （按服务器出口 IP 算，全服务器共用），刷十几次就打满。
# 建议用 Fine-grained PAT，只勾 Metadata（必选）、Contents、Actions、Issues、
# Pull requests 的**读**权限 —— 不要用 classic 的全量 repo（那是读写权限）。
GITHUB_TOKEN=
# 关注的仓库，格式 owner/repo，多个用英文逗号分隔
GITHUB_REPOS=
# 国内服务器直连 api.github.com 偶尔不稳时，可换一个可达的入口
GITHUB_API_BASE=https://api.github.com

# ---------------- CORS ----------------
# 允许访问 API 的前端地址，多个用英文逗号分隔
# 开发环境用 http://localhost:5173；生产用你的正式域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 对外访问地址（重要） ----------------
# 「系统设置 → MCP」里给 AI 工具复制的那份配置，用的就是这两个地址。
# ⚠️ 必须填**外网真正可达的 https 域名**：
#    填成 http://<服务器IP>:3001 之类是连不上的（端口没对外开），
#    粘到 AI 工具里会直接连接失败。
# 留空会自动退回「当前访问的域名 + 端口」，仅供本地开发。
PUBLIC_PANEL_URL=https://panel.example.com
PUBLIC_MCP_URL=https://mcp.example.com

# ---------------- 数据与日志 ----------------
# SQLite 数据库文件路径（容器内路径，docker-compose 已挂载到宿主机 ./data）
DB_PATH=./data/workbench.db
# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# ---------------- 限流 ----------------
# 每个 IP 每 15 分钟最多请求次数
RATE_LIMIT_MAX=600
# 登录接口每个 IP 每 15 分钟最多尝试次数
LOGIN_RATE_LIMIT_MAX=20
